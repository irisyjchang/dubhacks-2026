PHOTON_CONNECTION=spectrum
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PHONE_NUMBER=
PHOTON_ALLOWED_SENDER=
PHOTON_CHANNEL=imessage
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=figure_skating_coach

# Optional ElevenLabs voice notes (100% of eligible coaching replies)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# iMessage video uploads use the existing Python analysis service
NVIDIA_API_KEY=
IMESSAGE_VIDEO_MODE=nvidia

# Hosted video-analysis API; set this to switch iMessage uploads and move replies
# Update the URL whenever the temporary Cloudflare tunnel restarts
MESSAGING_AGENT_API_URL=
MESSAGING_AGENT_PROGRAM_TYPE=unk
MESSAGING_AGENT_PERCEPTRON_TRACK=true

# Photon Spectrum live calls via ElevenLabs SIP (separate from voice notes)
PHOTON_CALLS_ENABLED=false
PHOTON_CALLS_MODE=hosted
CALLS_PORT=8789
# Optional: set mode=webhook for live backend tools; hosted mode needs no URL
# Public HTTPS tunnel/proxy pointing ONLY to the call gateway on port 8789
CALLS_PUBLIC_URL=
