{
  "name": "feedback-loop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "imessage": "node --env-file=.env scripts/photon.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0",
    "type-check": "tsc --noEmit",
    "photon": "node --env-file=.env scripts/photon.mjs",
    "calls:plan": "node --env-file=.env scripts/photon-calls-cli.mjs plan",
    "calls:setup": "node --env-file=.env scripts/photon-calls-cli.mjs setup",
    "calls:allow-group": "node --env-file=.env scripts/photon-calls-cli.mjs allow-group",
    "calls:dial": "node --env-file=.env scripts/photon-calls-cli.mjs dial",
    "video-server": "node --env-file=.env scripts/video-server.mjs",
    "imessage-video-server": "node --env-file=.env scripts/video-server.mjs --backend --port 8001"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.8",
    "@photon-ai/advanced-imessage": "^2.3.0",
    "@photon-ai/imessage-kit": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "mongodb": "^7.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.8.4",
    "spectrum-ts": "^12.11.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.0.3"
  }
}
